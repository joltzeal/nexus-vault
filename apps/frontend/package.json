{
	"name": "@nexus-vault/frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"check:resource-input": "tsx ../../scripts/check-resource-input.ts",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ../../cloudflare-env.d.ts",
		"db:generate": "node ../../scripts/generate-migrations.mjs",
		"db:migrate:local": "node ../../scripts/apply-postgres-migration.mjs",
		"db:migrate:production": "node ../../scripts/apply-postgres-migration.mjs"
	},
	"dependencies": {
