{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@nexus-vault/auth": ["../../packages/auth/src/index.ts"],
      "@nexus-vault/auth/client": ["../../packages/auth/src/client.ts"],
      "@nexus-vault/auth/server": ["../../packages/auth/src/server.ts"],
      "@nexus-vault/db": ["../../packages/db/src/index.ts"],
      "@nexus-vault/db/better-auth-schema": [
        "../../packages/db/src/better-auth-schema.ts"
      ],
      "@nexus-vault/db/schema": ["../../packages/db/src/schema.ts"],
      "@nexus-vault/providers": ["../../packages/providers/src/index.ts"],
      "@nexus-vault/shared": ["../../packages/shared/src/index.ts"],
      "@nexus-vault/shared/permissions": [
        "../../packages/shared/src/permissions.ts"
      ],
      "@nexus-vault/shared/resource-input": [
        "../../packages/shared/src/resource-input.ts"
      ],
      "@nexus-vault/shared/resource-metadata": [
        "../../packages/shared/src/resource-metadata.ts"
      ],
      "@nexus-vault/ui": ["../../packages/ui/src/index.ts"]
    },
    "types": ["../../cloudflare-env.d.ts", "node"],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
