/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-vault",
	"main": "worker.ts",
	"compatibility_date": "2026-06-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"alias": {
		"@nexus-vault/auth": "../../packages/auth/src/index.ts",
		"@nexus-vault/auth/client": "../../packages/auth/src/client.ts",
		"@nexus-vault/auth/server": "../../packages/auth/src/server.ts",
		"@nexus-vault/db": "../../packages/db/src/index.ts",
		"@nexus-vault/db/better-auth-schema": "../../packages/db/src/better-auth-schema.ts",
		"@nexus-vault/db/schema": "../../packages/db/src/schema.ts",
		"@nexus-vault/providers": "../../packages/providers/src/index.ts",
		"@nexus-vault/shared": "../../packages/shared/src/index.ts",
		"@nexus-vault/shared/permissions": "../../packages/shared/src/permissions.ts",
		"@nexus-vault/shared/resource-input": "../../packages/shared/src/resource-input.ts",
		"@nexus-vault/shared/resource-metadata": "../../packages/shared/src/resource-metadata.ts",
		"@nexus-vault/ui": "../../packages/ui/src/index.ts"
	},
	"keep_vars": true,
	"vars": {
		"NEXTJS_ENV": "development"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "3271a1cca21447d9bc4ba2ff47a167ff",
			"localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/nexus_vault"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "local-development-cache"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nexus-vault-media-local"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "METADATA_QUEUE",
				"queue": "nexus-vault-metadata-local"
			},
			{
				"binding": "NOTIFICATION_QUEUE",
				"queue": "nexus-vault-notifications-local"
			}
		],
		"consumers": [
			{
				"queue": "nexus-vault-metadata-local",
				"max_batch_size": 1,
				"max_batch_timeout": 10,
				"max_retries": 3
			},
			{
				"queue": "nexus-vault-notifications-local",
				"max_batch_size": 10,
				"max_batch_timeout": 10,
				"max_retries": 3
			}
		]
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "nexus-vault"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"env": {
		"production": {
			"name": "nexus-vault",
			"vars": {
				"NEXTJS_ENV": "production"
			},
			"images": {
				"binding": "IMAGES"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "3271a1cca21447d9bc4ba2ff47a167ff"
				}
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "7221c902e852402a9b1a72aa81156a67"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "nexus-vault-media"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "METADATA_QUEUE",
						"queue": "nexus-vault-metadata"
					},
					{
						"binding": "NOTIFICATION_QUEUE",
						"queue": "nexus-vault-notifications"
					}
				],
				"consumers": [
					{
						"queue": "nexus-vault-metadata",
						"max_batch_size": 1,
						"max_batch_timeout": 10,
						"max_retries": 3
					},
					{
						"queue": "nexus-vault-notifications",
						"max_batch_size": 10,
						"max_batch_timeout": 10,
						"max_retries": 3
					}
				]
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "nexus-vault"
				}
			],
			"observability": {
				"enabled": true
			}
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
}
