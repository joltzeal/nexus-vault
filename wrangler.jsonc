/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-vault",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist/client"
	},
	"observability": {
		"enabled": true
	},
	"keep_vars": true,
	"minify": true,
	"upload_source_maps": true,
	"vars": {
		"NEXTJS_ENV": "development",
		"ALLOW_USER_REGISTRATION": "true",
		"TELEGRAM_METADATA_API_URL": "http://localhost:8080",
		"TELEGRAM_MEDIA_MAX_BYTES": "20971520"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nexus-vault-media-local",
			"preview_bucket_name": "nexus-vault-media-local",
			"remote": false
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "local-cache",
			"preview_id": "local-cache-preview",
			"remote": false
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "nexus-vault-queue",
				"remote": false
			},
			{
				"binding": "CLOUD_DRIVE_CHECK_QUEUE",
				"queue": "nexus-vault-cloud-drive-checks",
				"remote": false
			}
		],
		"consumers": [
			{
				"queue": "nexus-vault-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 30
			},
			{
				"queue": "nexus-vault-cloud-drive-checks",
				"max_batch_size": 5,
				"max_batch_timeout": 30
			}
		]
	},
	"env": {
		"production": {
			"name": "nexus-vault",
			"minify": true,
			"triggers": {
				"crons": [
					"15 19 * * *"
				]
			},
			"vars": {
				"NEXTJS_ENV": "production",
				"ALLOW_USER_REGISTRATION": "false",
				"TELEGRAM_METADATA_API_URL": "http://localhost:8080",
				"TELEGRAM_MEDIA_MAX_BYTES": "20971520"
			},
			"assets": {
				"binding": "ASSETS",
				"directory": "dist/client"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "3271a1cca21447d9bc4ba2ff47a167ff",
					"localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/nexus_vault"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "nexus-vault-media"
				}
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "7221c902e852402a9b1a72aa81156a67"
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"persist": true,
					"invocation_logs": true
				},
				"traces": {
					"enabled": true,
					"persist": true,
					"head_sampling_rate": 1
				}
			},
			"queues": {
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "nexus-vault-queue"
					},
					{
						"binding": "CLOUD_DRIVE_CHECK_QUEUE",
						"queue": "nexus-vault-cloud-drive-checks"
					}
				],
				"consumers": [
					{
						"queue": "nexus-vault-queue",
						"max_batch_size": 10,
						"max_batch_timeout": 30
					},
					{
						"queue": "nexus-vault-cloud-drive-checks",
						"max_batch_size": 5,
						"max_batch_timeout": 30
					}
				]
			}
		}
	}
}
