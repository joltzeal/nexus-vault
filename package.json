{
	"name": "nexus-vault",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:client": "vite --host localhost",
		"dev:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
		"build": "vite build",
		"start": "wrangler dev --port 8787",
		"lint": "eslint .",
		"auth:generate": "set -a && . ./.dev.vars && set +a && pnpm dlx auth@latest generate --config ./auth.ts --output ./src/db/auth-schema.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:push:local": "drizzle-kit push",
		"deploy": "vite build && wrangler deploy --env production",
		"upload": "vite build && wrangler deploy --env production",
		"preview": "vite build && wrangler dev",
		"preview:production": "vite build && wrangler dev --env production",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"twitter:metadata": "tsx scripts/twitter-metadata-local.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@better-auth-ui/core": "^1.6.34",
		"@better-auth-ui/react": "^1.6.34",
		"@better-auth/drizzle-adapter": "^1.6.25",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/react": "^0.5.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hugeicons/core-free-icons": "^4.2.3",
		"@hugeicons/react": "^1.1.9",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@shadcn/react": "^0.2.1",
		"@tanstack/react-pacer": "^0.22.1",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.10",
		"@the-convocation/twitter-scraper": "^0.22.3",
		"@uppy/aws-s3": "^5.1.0",
		"@uppy/core": "^5.2.0",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.6.25",
		"better-auth-cloudflare": "^0.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"embla-carousel-react": "^8.6.0",
		"hono": "^4.12.32",
		"input-otp": "^1.4.2",
		"live-photo": "^0.2.0",
		"lucide-react": "^1.27.0",
		"motion": "^12.42.2",
		"pinyin-pro": "^3.28.2",
		"postgres": "^3.4.9",
		"react": "^19.1.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.1.7",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.12.2",
		"react-tweet": "^3.3.1",
		"recharts": "3.8.0",
		"shadcn": "^4.18.0",
		"sonner": "^2.0.7",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.43",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^6.0.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.8.0",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"wrangler": "^4.114.0"
	}
}
