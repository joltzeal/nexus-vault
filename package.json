{
	"name": "nexus-vault",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test:twitter": "tsx scripts/twitter-live.test.ts",
		"auth:set-password": "tsx scripts/set-auth-password.ts",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run deploy:production",
		"deploy:local": "pnpm run build && wrangler deploy",
		"deploy:production": "pnpm run build && wrangler deploy --config wrangler.jsonc --env production --keep-vars",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:preserve": "tsx scripts/migrate-preserve.ts",
		"db:migrate:local": "drizzle-kit migrate"
	},
