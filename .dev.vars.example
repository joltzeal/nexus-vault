# Local Worker secrets. Copy to .dev.vars and replace values.
# .dev.vars is ignored by git.
BETTER_AUTH_SECRET=replace-with-a-local-random-secret
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
ALLOW_USER_REGISTRATION=true
ALLOW_RESOURCE_MEDIA_UPLOAD=true
S3_UPLOAD_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_UPLOAD_BUCKET=nexus-vault-media
S3_UPLOAD_REGION=auto
S3_UPLOAD_FORCE_PATH_STYLE=false
S3_MEDIA_PUBLIC_BASE_URL=https://<public-r2-domain>
TURNSTILE_SITE_KEY=replace-with-local-site-key
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TELEGRAM_METADATA_API_URL=https://example.invalid/telegram
BROWSERLESS_SCREENSHOT_ENDPOINT=https://example.invalid/screenshot
AI_GATEWAY_ID=default
AI_SUMMARY_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
